# TurfSpotX Backend Environment Variables
# Copy this file to .env and fill in real values

# ── Django Core ───────────────────────────
SECRET_KEY=replace-with-a-secure-random-key
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ── Database ──────────────────────────────
# Render provides DATABASE_URL automatically for PostgreSQL
# For local dev, leave unset to use SQLite
DATABASE_URL=

# ── Redis (for channels + caching) ───────
REDIS_URL=

# ── Razorpay ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (Meta) ─────────────
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_TEMPLATE_NAME=turfspot_otp
WHATSAPP_VERIFY_TOKEN=turfspot_verify_2026
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ── When Razorpay is NOT configured ──────
# Flutter automatically falls back to /api/bookings/bookings/confirm/
# (direct confirm without payment gateway). Perfect for testing without keys.
