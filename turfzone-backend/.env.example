# TurfZone Backend Environment Variables
# Copy this file to .env and fill in real values

# ── Database ──────────────────────────────
DB_ENGINE=sqlite3          # sqlite3 | postgresql
DB_NAME=turfzone
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# ── Razorpay (Test Keys — safe to test, no real charges) ──────────────────
# Get your test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_TEMPLATE_NAME=your_template_name
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

# ── When Razorpay is NOT configured ──────────────────────────────────────
# Flutter automatically falls back to /api/bookings/bookings/confirm/
# (direct confirm without payment gateway). Perfect for testing without keys.
